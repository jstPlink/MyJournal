<?xml version="1.0" encoding="utf-8"?>
<!-- Widget 1x3 verticale "MyJournal": gli stessi tre blocchi del 4x1 (mood degli ultimi 3 giorni, ultima nota,
     pulsante "Nuova nota" appeso al chiodo) ma impilati dall'alto in basso. Usa gli STESSI id del 4x1
     (widget_summary.xml): MyJournalSummaryWidget.render li riempie allo stesso modo. Va tenuto allineato a
     widget_summary_vertical_preview.xml. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="4dp">

    <LinearLayout
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingBottom="6dp"
        android:paddingTop="6dp">

        <!-- 1. Mood degli ultimi 3 giorni, in un cartoncino del colore del mood (come nel 4x1) -->
        <LinearLayout
            android:id="@+id/sum_block_mood"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:clipChildren="false"
                android:layout_width="62dp"
                android:layout_height="66dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="2dp"
                    android:layout_marginStart="1dp"
                    android:contentDescription="@null"
                    android:rotation="-1"
                    android:src="@drawable/widget_paper_shadow" />

                <ImageView
                    android:id="@+id/sum_mood_dot"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="1dp"
                    android:layout_marginEnd="1dp"
                    android:contentDescription="@null"
                    android:rotation="-2"
                    android:src="@drawable/widget_card"
                    android:tint="#b9b4a8" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingLeft="3dp"
                    android:paddingRight="3dp"
                    android:rotation="-2">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="casual"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/widget_mood_caption_short"
                        android:textColor="#b8281e0f"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/sum_mood_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="casual"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="—"
                        android:textColor="#2a2113"
                        android:shadowColor="#2a2113"
                        android:shadowDx="1.2"
                        android:shadowDy="0.9"
                        android:shadowRadius="0.7"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/sum_mood_sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="casual"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxLines="2"
                        android:textColor="#cc2a2113"
                        android:textSize="9sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="8dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="-3dp"
                    android:contentDescription="@null"
                    android:rotation="3"
                    android:src="@drawable/widget_card_tape" />
            </FrameLayout>
        </LinearLayout>

        <!-- 2. Ultima nota -->
        <LinearLayout
            android:id="@+id/sum_block_last"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="13dp"
                android:fontFamily="casual"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_last_caption"
                android:textColor="#7a6f5b"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/sum_last_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="casual"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:text="—"
                android:textColor="#3a3226"
                android:shadowColor="#3a3226"
                android:shadowDx="1.3"
                android:shadowDy="1.0"
                android:shadowRadius="0.8"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/sum_last_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="casual"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#4a4132"
                android:shadowColor="#4a4132"
                android:shadowDx="0.9"
                android:shadowDy="0.7"
                android:shadowRadius="0.6"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 3. Nuova nota appesa a un chiodo (ondeggia ogni tanto: ViewFlipper con due copie identiche) -->
        <LinearLayout
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginBottom="-3dp"
                android:contentDescription="@null"
                android:src="@drawable/widget_nail" />

            <ViewFlipper
                android:id="@+id/sum_flipper"
                android:clipChildren="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:autoStart="true"
                android:flipInterval="7400"
                android:inAnimation="@anim/widget_swing">

                <LinearLayout
                    android:id="@+id/sum_btn_new"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_button"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingBottom="9dp"
                    android:paddingLeft="9dp"
                    android:paddingRight="9dp"
                    android:paddingTop="6dp"
                    android:rotation="2">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="casual"
                        android:includeFontPadding="false"
                        android:text="+"
                        android:textColor="#3a3226"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="casual"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/widget_new_note"
                        android:textColor="#3a3226"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/sum_btn_new2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_button"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingBottom="9dp"
                    android:paddingLeft="9dp"
                    android:paddingRight="9dp"
                    android:paddingTop="6dp"
                    android:rotation="2">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="casual"
                        android:includeFontPadding="false"
                        android:text="+"
                        android:textColor="#3a3226"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="casual"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/widget_new_note"
                        android:textColor="#3a3226"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </ViewFlipper>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
