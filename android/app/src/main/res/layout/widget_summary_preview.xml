<?xml version="1.0" encoding="utf-8"?>
<!-- Widget 4x1 su foglio a righe. Sinistra: mood degli ultimi 3 giorni in un cartoncino quadrato dai lati
     tagliuzzati (tinto col colore del mood). Centro: ultima nota (giorno e ora di fine) in un cartoncino
     a quadretti dagli angoli stondati, più scuro. Destra: pulsante "Nuova nota" appeso a un chiodo.
     ANTEPRIMA del selettore dei widget (previewLayout): stesso aspetto con dati d'esempio,
     pulsante fermo, niente ViewFlipper; va tenuta allineata a widget_summary.xml. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="4dp">

    <LinearLayout
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <!-- 1. Mood degli ultimi 3 giorni: cartoncino quadrato con i lati tagliuzzati -->
        <FrameLayout
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:layout_gravity="center_vertical">

            <ImageView
                android:layout_width="66dp"
                android:layout_height="66dp"
                android:layout_marginStart="1.5dp"
                android:layout_marginTop="2dp"
                android:contentDescription="@null"
                android:rotation="3"
                android:src="@drawable/widget_card_jagged"
                android:tint="#8a5c4a2a" />

            <ImageView
                android:layout_width="66dp"
                android:layout_height="66dp"
                android:contentDescription="@null"
                android:rotation="-1.5"
                android:src="@drawable/widget_card_jagged"
                android:tint="#d8d2c4" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="5dp"
                android:paddingEnd="5dp">

                <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="casual"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_mood_caption"
                android:textColor="#5a4e38"
                android:textSize="8sp"
                android:textStyle="bold" />

                <TextView
                android:id="@+id/sum_mood_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="casual"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="72"
                android:textColor="#3a3226"
                android:textSize="24sp"
                android:textStyle="bold"
                android:shadowColor="#3a3226"
                android:shadowDx="1.2"
                android:shadowDy="0.9"
                android:shadowRadius="0.8" />

                <TextView
                android:id="@+id/sum_mood_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="casual"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="3 gg · 5 note"
                android:textColor="#3a3226"
                android:textSize="8sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- 2. Ultima nota: cartoncino a quadretti con gli angoli stondati -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="66dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:background="@drawable/widget_card_checks"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="casual"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_last_caption"
                android:textColor="#5a4e38"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/sum_last_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="casual"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="ieri"
                android:textColor="#3a3226"
                android:textSize="21sp"
                android:textStyle="bold"
                android:shadowColor="#3a3226"
                android:shadowDx="1.2"
                android:shadowDy="0.9"
                android:shadowRadius="0.8" />

            <TextView
                android:id="@+id/sum_last_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="casual"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="21:30"
                android:textColor="#3a3226"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 3. Nuova nota: un vero pulsante in rilievo, appeso a un chiodo. Ogni tanto ondeggia attorno a quel
             solo punto: il ViewFlipper alterna due copie IDENTICHE del pulsante e l'animazione di ingresso
             (anim/widget_swing, pivot in alto al centro) è l'oscillazione smorzata. flipInterval = pausa fra
             un'oscillazione e l'altra. -->
        <LinearLayout
            android:clipChildren="false"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginBottom="-3dp"
                android:contentDescription="@null"
                android:src="@drawable/widget_nail" />

            <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_button"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingBottom="9dp"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:paddingTop="6dp"
                    android:rotation="2">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="casual"
                        android:includeFontPadding="false"
                        android:text="+"
                        android:textColor="#3a3226"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="casual"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/widget_new_note"
                        android:textColor="#3a3226"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
