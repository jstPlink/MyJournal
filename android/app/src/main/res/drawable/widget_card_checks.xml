<?xml version="1.0" encoding="utf-8"?>
<!-- Cartoncino a quadretti, angoli stondati, più scuro della carta: come la scritta del giorno
     nella vista giorno della versione web (.toast-paper: #dccfa8, quadretti, contorno #8c7a52) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#dccfa8" />
            <corners android:radius="12dp" />
            <stroke android:width="1.5dp" android:color="#8c7a52" />
        </shape>
    </item>
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp"
        android:drawable="@drawable/widget_checks_tile" />
</layer-list>
